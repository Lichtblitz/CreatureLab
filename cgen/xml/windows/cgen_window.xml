<root>
	<!-- templates -->
	<template name="cgen_button_genesis">
		<button_text_sm>
			<state textres="cgen_button_genesis" />

			<gmvisibleonly />
				<!-- we pass the text within the input field to our lua script
					which will parse the contents, we will ideally receive an
					object representing the content parsed -->
			<script>
				function onButtonPress()
					local creList, creData, err, errmsg; 
					local cgen_window = Interface.findWindow("cgen_window","cgen");
					local cgen_node = cgen_window.getDatabaseNode();

					creData = nil; 
					if (nil ~= cgen_node) then
						local nodes = cgen_node.getChildren(); 
						creData = CreatureGen.genesis(nodes["input"].getValue()); 
						cgen_node.createChild('lograw','formattedtext'); 
						local lnode = cgen_node.getChild('lograw');
						lnode.setValue(creData['log']); 
						cgen_node.getChild('log').setValue(''); 

						local logLevel = DB.getValue(cgen_node,'loglevel',''); 
						CreatureGen.dlog('loglevel on creation is ' .. tostring(logLevel)); 
						CreatureGenWindow.processLog(tonumber(logLevel)); 

						if creData.creature.error == true then
							return;
						end
						local npclist = DB.findNode('npc');
						Debug.console(tostring(npclist),self); 
						if npclist then
							creList = npclist.createChild();
						end
						err, errmsg = pcall(CreatureGen.populate,creList,creData); 
						if not err then
							CreatureGen.addError('Error when populating character record: ' .. errmsg); 
							CreatureGen.sendErrors(); 
							CreatureGen.sendWarnings(); 
							creList.delete(); 
						else
							local npcWind = Interface.openWindow("npc",creList);
							local log = CreatureGen.dumpLog(5); 
							lnode.setValue(log);
							CreatureGenWindow.processLog(tonumber(logLevel)); 
						end
					end
				end
			</script>
		</button_text_sm>
	</template>

	<template name="cgen_button_launch">
		<button_text_sm>
			<anchored position="insidetopright" offset="75,2" width="50"/>
			<state textres="cgen_button_launch" />

			<gmvisibleonly />
			<script>
				function onButtonPress()
					Interface.openWindow("cgen_window","cgen"); 
				end
			</script>
		</button_text_sm>
	</template>

	<template name="radio_record_cgen_log_level">
		<buttongroup_radio>
			<anchored to="controlframe" height="20">
				<top offset="8" />
				<left anchor="center" offset="-200" />
			</anchored>
			<parameters>
				<optionwidth>75</optionwidth>
				<labelsres>cgen_label_logmsg|cgen_label_log1|cgen_label_log2|cgen_label_log3|cgen_label_log4|cgen_label_log5</labelsres>
				<values>0|1|2|3|4|5</values>
			</parameters>
			<gmeditonly />
			<script>
				function onValueChanged()
					window.onRadioLogChanged(); 
				end
			</script>
		</buttongroup_radio>
	</template>

	<template name="frame_record_logbar">
		<genericcontrol>
			<anchored>
				<top anchor="bottom" offset="-50" />
				<left offset="15" />
				<right offset="-20" />
				<bottom offset="-15" />
			</anchored>
			<frame name="groupbox" />
			<disabled />
		</genericcontrol>
	</template>

	<!-- windows -->

	<windowclass name="cgen_header">
		<margins control="0,0,0,7" />
		<sheetdata>
			<cgen_button_genesis name="genesis_button">
				<anchored position="insidetop">
					<top offset="25" />
					<left offset="15" />
					<right offset="-20" />
				</anchored>
			</cgen_button_genesis>
		</sheetdata>
	</windowclass>

	<windowclass name="cgen_input_contents">
		<margins control="0,0,0,2" />
		<sheetdata>
			<label name='input_label'>
				<anchored>
					<top />
					<left />
					<right />
				</anchored>
				<static textres='cgen_label_inputtext' />
			</label>
			<formattedtextfield name="input">
				<anchored>
					<top offset="30" />
					<left />
					<bottom />
					<right offset="-10" />
				</anchored>
			</formattedtextfield>
			<scrollbar_content>
				<anchored to="input" />
				<target>input</target>
			</scrollbar_content>
		</sheetdata>
	</windowclass>

	<windowclass name="cgen_log_contents">
		<margins control="0,0,0,2" />
		<sheetdata>
			<label name='log_label'>
				<anchored>
					<top />
					<left />
					<right />
				</anchored>
				<static textres='cgen_label_logtext' />
			</label>
			<formattedtextfield name="log">
				<anchored>
					<top offset="30" />
					<left />
					<bottom />
					<right offset="-10" />
				</anchored>
			</formattedtextfield>
			<scrollbar_content name="scrollbar_log">
				<anchored to="log" />
				<target>log</target>
			</scrollbar_content>
		</sheetdata>
	</windowclass>

	<windowclass name="cgen_content">
		<margins control="10,10,10,12" />
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />
			<sub_content_framed_groupbox_left name="input_content">
				<class>cgen_input_contents</class>
			</sub_content_framed_groupbox_left>
			<sub_content_framed_groupbox_right name="log_content">
				<class>cgen_log_contents</class>
			</sub_content_framed_groupbox_right>
		</sheetdata>
	</windowclass>

	<windowclass name="cgen_window">
		<frame>recordsheet</frame>
		<script file="cgen/lua/CreatureGenWindow.lua" />
		<sizelimits>
			<minimum width="1000" height="600" />
		</sizelimits>
		<sheetdata>
			<anchor_content_top />
			<anchor_content_bottom />
			<sub_content_top name="headers">
				<class>cgen_header</class>
			</sub_content_top>
			<sub_content name="content">
				<anchored>
					<bottom offset="-45" />
				</anchored>
				<class>cgen_content</class>
			</sub_content>
			<frame_record_logbar name="controlframe" />
			<radio_record_cgen_log_level name="loglevel" />
		</sheetdata>
	</windowclass>
</root>
